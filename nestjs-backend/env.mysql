# Application
PORT=3000
NODE_ENV=development

# Database - MySQL (XAMPP)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nestjs_database
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=*

# File Upload
UPLOAD_DEST=./storage/uploads
MAX_FILE_SIZE=10485760

