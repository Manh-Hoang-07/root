# Application
PORT=3000
NODE_ENV=development

# Database
DB_TYPE=better-sqlite3
DB_DATABASE=database/nestjs-database.sqlite
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=*

# File Upload
UPLOAD_DEST=./storage/uploads
MAX_FILE_SIZE=10485760

